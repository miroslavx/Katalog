<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Katalog.WardrobePage"
             Title="Riidekapp"
             BackgroundColor="#FFFFFF">

    <Grid RowDefinitions="*, Auto">

        <ContentView Grid.Row="0" Padding="15">
            <CollectionView x:Name="ClothesList" SelectionMode="Single" SelectionChanged="OnSelectionChanged">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="2" HorizontalItemSpacing="15" VerticalItemSpacing="15"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout>
                            <Border Padding="0" 
                                    StrokeShape="RoundRectangle 12" 
                                    Stroke="Transparent" 
                                    BackgroundColor="#F2F2F7">
                                <Image Source="{Binding ImagePath}" Aspect="AspectFill" HeightRequest="160" />
                            </Border>

                            <Label Text="{Binding Name}" FontAttributes="Bold" TextColor="#000000" Margin="0,8,0,0" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Category}" TextColor="#8E8E93" FontSize="12" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </ContentView>

        <Border Grid.Row="1" BackgroundColor="#FFFFFF" Padding="15,10,15,20" StrokeThickness="0.5" Stroke="#E5E5EA">
            <Button Text="Lisa uus ese" 
                    ImageSource="icon_add.png"
                    BackgroundColor="#007AFF" 
                    TextColor="#FFFFFF" 
                    FontAttributes="Bold"
                    HeightRequest="50"
                    CornerRadius="10"
                    Clicked="OnAddNewClicked"/>
        </Border>

    </Grid>
</ContentPage>