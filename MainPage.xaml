<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Katalog.MainPage"
             BackgroundColor="#F2F2F7">


    <ScrollView>
        <VerticalStackLayout Padding="20,40,20,20" Spacing="25">

            <Label Text="GARDEROOB" 
                   TextColor="#000000" 
                   FontAttributes="Bold" 
                   FontSize="32" 
                   Margin="0,0,0,10" />

            <Frame BackgroundColor="#007AFF" CornerRadius="16" HasShadow="False" Padding="25">
                <VerticalStackLayout Spacing="10">
                    <Image Source="icon_weather.png" HeightRequest="40" HorizontalOptions="Start" />

                    <Label Text="Mida ma täna kannan?" 
                           TextColor="#FFFFFF" 
                           FontAttributes="Bold" 
                           FontSize="22" />

                    <Label Text="Las nutikas algoritm valib sulle ideaalse riietuse." 
                           TextColor="#E5F0FF" 
                           FontSize="14" />

                    <Button Text="Vali riietus (Ilm)" 
                            BackgroundColor="#FFFFFF" 
                            TextColor="#007AFF" 
                            FontAttributes="Bold"
                            CornerRadius="8" 
                            HeightRequest="44" 
                            Margin="0,15,0,0"
                            Clicked="OnWeatherClicked"/>
                </VerticalStackLayout>
            </Frame>

            <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, *" RowSpacing="15" ColumnSpacing="15">

                <!-- Карточка 1: Шкаф -->
                <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="#FFFFFF" CornerRadius="16" HasShadow="False" Padding="20">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnOpenWardrobeClicked"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Image Source="icon_wardrobe.png" HeightRequest="35" HorizontalOptions="Start" />
                        <Label Text="Riidekapp" TextColor="#000000" FontAttributes="Bold" FontSize="16" />
                        <Label Text="Sinu asjad" TextColor="#8E8E93" FontSize="12" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Карточка 2: Рандом -->
                <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#FFFFFF" CornerRadius="16" HasShadow="False" Padding="20">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRandomClicked"/>
                    </Frame.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Image Source="icon_random.png" HeightRequest="35" HorizontalOptions="Start" />
                        <Label Text="Juhuslik" TextColor="#000000" FontAttributes="Bold" FontSize="16" />
                        <Label Text="Suvaline valik" TextColor="#8E8E93" FontSize="12" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Карточка 3: Пресет (Стиль) -->
                <Frame Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="#FFFFFF" CornerRadius="16" HasShadow="False" Padding="20">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnPresetClicked"/>
                    </Frame.GestureRecognizers>
                    <HorizontalStackLayout Spacing="15" VerticalOptions="Center">
                        <Image Source="icon_formal.png" HeightRequest="35" />
                        <VerticalStackLayout VerticalOptions="Center">
                            <Label Text="Ametlik stiil" TextColor="#000000" FontAttributes="Bold" FontSize="16" />
                            <Label Text="Valmis komplektid sündmusteks" TextColor="#8E8E93" FontSize="12" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Frame>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>